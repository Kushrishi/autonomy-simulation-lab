#!/usr/bin/env python3
"""Check installed synthetic replay, repeatability and fault detection."""

import argparse
import json
from pathlib import Path
import subprocess
import sys

prefix = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(prefix / "share/asl-replay/tools"))
from example import example

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "output", type=Path, help="New directory for the example and report"
)
args = parser.parse_args()
try:
    report = example(prefix / "bin/asl-replay", args.output)
except (ValueError, OSError, subprocess.CalledProcessError) as error:
    parser.exit(2, f"example failed: {error}\n")
print(
    json.dumps(
        {
            "exact_repeat_passed": not report["exact_repeat"]["changed_frames"],
            "detected_fault_frames": report["injected_fault"]["changed_frames"],
            "report": str(args.output / "report.json"),
            "scope": "synthetic recording; injected result change, not a model accuracy test",
        },
        indent=2,
    )
)
